// RUN: ttvortex-opt %s --pass-pipeline='builtin.module(convert-scf-to-cf,convert-triton-gpu-to-vortex-llvm,reconcile-unrealized-casts,canonicalize,cse,symbol-dce)' -o %t
// RUN: FileCheck %s --input-file=%t --implicit-check-not='tensor<' --implicit-check-not='unrealized_conversion_cast' --implicit-check-not='tt.' --implicit-check-not='ttg.convert_layout'

// Generated from examples/basic.py via TTIR -> ttvortex-opt (see README.md).
// Positive test: lowering must succeed; no expected failure or diagnostic match.
// BLOCK=256 / (4 warps * 32 lanes) gives two scalar f32 adds per thread.
// Check both masked inputs, sums, and stores; inactive loads contribute zero.
// CHECK-LABEL: llvm.func @float_add
// CHECK: %[[ZERO:.*]] = llvm.mlir.constant(0.000000e+00 : f32)
// CHECK: llvm.cond_br %[[MASK0:.*]], ^[[READ_A0:bb[0-9]+]], ^[[MERGE_A0:bb[0-9]+]](%[[ZERO]] : f32)
// CHECK: ^[[READ_A0]]:
// CHECK-NEXT: %[[LOAD_A0:.*]] = llvm.load {{.*}} : !llvm.ptr -> f32
// CHECK-NEXT: llvm.br ^[[MERGE_A0]](%[[LOAD_A0]] : f32)
// CHECK: ^[[MERGE_A0]](%[[A0:[a-zA-Z0-9_]+]]: f32):
// CHECK: llvm.cond_br %[[MASK1:.*]], ^[[READ_A1:bb[0-9]+]], ^[[MERGE_A1:bb[0-9]+]](%[[ZERO]] : f32)
// CHECK: ^[[READ_A1]]:
// CHECK-NEXT: %[[LOAD_A1:.*]] = llvm.load {{.*}} : !llvm.ptr -> f32
// CHECK-NEXT: llvm.br ^[[MERGE_A1]](%[[LOAD_A1]] : f32)
// CHECK: ^[[MERGE_A1]](%[[A1:[a-zA-Z0-9_]+]]: f32):
// CHECK: llvm.cond_br %[[MASK0]], ^[[READ_B0:bb[0-9]+]], ^[[MERGE_B0:bb[0-9]+]](%[[ZERO]] : f32)
// CHECK: ^[[READ_B0]]:
// CHECK-NEXT: %[[LOAD_B0:.*]] = llvm.load {{.*}} : !llvm.ptr -> f32
// CHECK-NEXT: llvm.br ^[[MERGE_B0]](%[[LOAD_B0]] : f32)
// CHECK: ^[[MERGE_B0]](%[[B0:[a-zA-Z0-9_]+]]: f32):
// CHECK: llvm.cond_br %[[MASK1]], ^[[READ_B1:bb[0-9]+]], ^[[MERGE_B1:bb[0-9]+]](%[[ZERO]] : f32)
// CHECK: ^[[READ_B1]]:
// CHECK-NEXT: %[[LOAD_B1:.*]] = llvm.load {{.*}} : !llvm.ptr -> f32
// CHECK-NEXT: llvm.br ^[[MERGE_B1]](%[[LOAD_B1]] : f32)
// CHECK: ^[[MERGE_B1]](%[[B1:[a-zA-Z0-9_]+]]: f32):
// CHECK: %[[SUM0:.*]] = llvm.fadd %[[A0]], %[[B0]] : f32
// CHECK: %[[SUM1:.*]] = llvm.fadd %[[A1]], %[[B1]] : f32
// CHECK: llvm.cond_br %[[MASK0]], ^[[WRITE0:bb[0-9]+]], ^[[END0:bb[0-9]+]]
// CHECK: ^[[WRITE0]]:
// CHECK-NEXT: llvm.store %[[SUM0]], {{.*}} : f32, !llvm.ptr
// CHECK-NEXT: llvm.br ^[[END0]]
// CHECK: llvm.cond_br %[[MASK1]], ^[[WRITE1:bb[0-9]+]], ^[[END1:bb[0-9]+]]
// CHECK: ^[[WRITE1]]:
// CHECK-NEXT: llvm.store %[[SUM1]], {{.*}} : f32, !llvm.ptr
// CHECK-NEXT: llvm.br ^[[END1]]
// CHECK: llvm.return

#blocked = #ttg.blocked<{sizePerThread = [1], threadsPerWarp = [32], warpsPerCTA = [4], order = [0]}>
module attributes {"ttg.num-ctas" = 1 : i32, "ttg.num-warps" = 4 : i32, ttg.target = "vortex:32", "ttg.threads-per-warp" = 32 : i32} {
  tt.func public @float_add(%arg0: !tt.ptr<f32>, %arg1: !tt.ptr<f32>, %arg2: !tt.ptr<f32>, %arg3: i32) attributes {noinline = false} {
    %cst = arith.constant dense<0.000000e+00> : tensor<256xf32, #blocked>
    %c256_i32 = arith.constant 256 : i32
    %0 = tt.get_program_id x : i32
    %1 = arith.muli %0, %c256_i32 : i32
    %2 = tt.make_range {end = 256 : i32, start = 0 : i32} : tensor<256xi32, #blocked>
    %3 = tt.splat %1 : i32 -> tensor<256xi32, #blocked>
    %4 = arith.addi %3, %2 : tensor<256xi32, #blocked>
    %5 = tt.splat %arg0 : !tt.ptr<f32> -> tensor<256x!tt.ptr<f32>, #blocked>
    %6 = tt.addptr %5, %4 : tensor<256x!tt.ptr<f32>, #blocked>, tensor<256xi32, #blocked>
    %7 = tt.splat %arg3 : i32 -> tensor<256xi32, #blocked>
    %8 = arith.cmpi slt, %4, %7 : tensor<256xi32, #blocked>
    %9 = tt.load %6, %8, %cst : tensor<256x!tt.ptr<f32>, #blocked>
    %10 = tt.splat %arg1 : !tt.ptr<f32> -> tensor<256x!tt.ptr<f32>, #blocked>
    %11 = tt.addptr %10, %4 : tensor<256x!tt.ptr<f32>, #blocked>, tensor<256xi32, #blocked>
    %12 = tt.load %11, %8, %cst : tensor<256x!tt.ptr<f32>, #blocked>
    %13 = tt.splat %arg2 : !tt.ptr<f32> -> tensor<256x!tt.ptr<f32>, #blocked>
    %14 = tt.addptr %13, %4 : tensor<256x!tt.ptr<f32>, #blocked>, tensor<256xi32, #blocked>
    %15 = arith.addf %9, %12 : tensor<256xf32, #blocked>
    tt.store %14, %15, %8 : tensor<256x!tt.ptr<f32>, #blocked>
    tt.return
  }
}
