// RUN: ttvortex-opt %s --pass-pipeline='builtin.module(convert-scf-to-cf,convert-triton-gpu-to-vortex-llvm,reconcile-unrealized-casts,canonicalize,cse,symbol-dce)' -o %t
// RUN: FileCheck %s --input-file=%t --implicit-check-not='tensor<' --implicit-check-not='unrealized_conversion_cast' --implicit-check-not='tt.' --implicit-check-not='ttg.convert_layout'
// RUN: FileCheck %s --check-prefix=ADDRESS --input-file=%t

// Generated from examples/basic.py via TTIR -> ttvortex-opt (see README.md).
// 16x16 tile. Source rows use COLS as stride; destination rows use ROWS.
// The transposed layout moves values between warps: expect shared-memory
// exchange and a barrier, not only a renamed tensor or independent lane copy.
// Address and exchange checks run separately to avoid fixing their scheduling.
// ADDRESS-LABEL: llvm.func @transpose(
// ADDRESS-SAME: %[[SRC:[a-zA-Z0-9_]+]]: !llvm.ptr, %[[OUT:[a-zA-Z0-9_]+]]: !llvm.ptr, %[[ROWS:[a-zA-Z0-9_]+]]: i32, %[[COLS:[a-zA-Z0-9_]+]]: i32)
// ADDRESS-DAG: %[[XCSR:.*]] = llvm.mlir.constant(3286 : i32)
// ADDRESS-DAG: %[[YCSR:.*]] = llvm.mlir.constant(3287 : i32)
// ADDRESS-DAG: llvm.inline_asm asm_dialect = att "csrr $0, $1", "=r,i" %[[XCSR]]
// ADDRESS-DAG: llvm.inline_asm asm_dialect = att "csrr $0, $1", "=r,i" %[[YCSR]]
// ADDRESS-DAG: %[[SRCROW:.*]] = llvm.mul %{{.*}}, %[[COLS]] : i32
// ADDRESS-DAG: llvm.getelementptr %[[SRC]][%[[SRCROW]]] : (!llvm.ptr, i32) -> !llvm.ptr, i32
// ADDRESS-DAG: %[[DSTROW:.*]] = llvm.mul %{{.*}}, %[[ROWS]] : i32
// ADDRESS-DAG: llvm.getelementptr %[[OUT]][%[[DSTROW]]] : (!llvm.ptr, i32) -> !llvm.ptr, i32
// CHECK: ttg.shared = {{[1-9][0-9]*}} : i32
// CHECK-LABEL: llvm.func @transpose
// CHECK: llvm.cond_br
// CHECK: llvm.load {{.*}} : !llvm.ptr -> i32
// CHECK: llvm.store {{.*}} : {{(vector<[0-9]+xi32>|i32)}}, !llvm.ptr
// CHECK: llvm.inline_asm has_side_effects asm_dialect = att ".insn r 0x0b, 4, 0, x0, $0, $1", "r,r,~{memory}"
// CHECK: llvm.load {{.*}} : !llvm.ptr -> {{(vector<[0-9]+xi32>|i32)}}
// CHECK: llvm.cond_br
// CHECK: llvm.store {{.*}} : i32, !llvm.ptr
// CHECK: llvm.return

#blocked = #ttg.blocked<{sizePerThread = [1, 1], threadsPerWarp = [2, 16], warpsPerCTA = [4, 1], order = [1, 0]}>
#blocked1 = #ttg.blocked<{sizePerThread = [1], threadsPerWarp = [32], warpsPerCTA = [4], order = [0]}>
#blocked2 = #ttg.blocked<{sizePerThread = [1, 1], threadsPerWarp = [32, 1], warpsPerCTA = [4, 1], order = [0, 1]}>
#blocked3 = #ttg.blocked<{sizePerThread = [1, 1], threadsPerWarp = [32, 1], warpsPerCTA = [4, 1], order = [1, 0]}>
#blocked4 = #ttg.blocked<{sizePerThread = [1, 1], threadsPerWarp = [1, 32], warpsPerCTA = [1, 4], order = [0, 1]}>
#blocked5 = #ttg.blocked<{sizePerThread = [1, 1], threadsPerWarp = [16, 2], warpsPerCTA = [1, 4], order = [0, 1]}>
module attributes {"ttg.num-ctas" = 1 : i32, "ttg.num-warps" = 4 : i32, ttg.target = "vortex:32", "ttg.threads-per-warp" = 32 : i32} {
  tt.func public @transpose(%arg0: !tt.ptr<i32>, %arg1: !tt.ptr<i32>, %arg2: i32, %arg3: i32) attributes {noinline = false} {
    %cst = arith.constant dense<0> : tensor<16x16xi32, #blocked>
    %c16_i32 = arith.constant 16 : i32
    %0 = tt.get_program_id y : i32
    %1 = arith.muli %0, %c16_i32 : i32
    %2 = tt.make_range {end = 16 : i32, start = 0 : i32} : tensor<16xi32, #blocked1>
    %3 = tt.splat %1 : i32 -> tensor<16xi32, #blocked1>
    %4 = arith.addi %3, %2 : tensor<16xi32, #blocked1>
    %5 = tt.get_program_id x : i32
    %6 = arith.muli %5, %c16_i32 : i32
    %7 = tt.splat %6 : i32 -> tensor<16xi32, #blocked1>
    %8 = arith.addi %7, %2 : tensor<16xi32, #blocked1>
    %9 = ttg.convert_layout %4 : tensor<16xi32, #blocked1> -> tensor<16xi32, #ttg.slice<{dim = 1, parent = #blocked2}>>
    %10 = tt.expand_dims %9 {axis = 1 : i32} : tensor<16xi32, #ttg.slice<{dim = 1, parent = #blocked2}>> -> tensor<16x1xi32, #blocked2>
    %11 = ttg.convert_layout %10 : tensor<16x1xi32, #blocked2> -> tensor<16x1xi32, #blocked3>
    %12 = tt.splat %arg3 : i32 -> tensor<16x1xi32, #blocked3>
    %13 = arith.muli %11, %12 : tensor<16x1xi32, #blocked3>
    %14 = tt.splat %arg0 : !tt.ptr<i32> -> tensor<16x1x!tt.ptr<i32>, #blocked3>
    %15 = tt.addptr %14, %13 : tensor<16x1x!tt.ptr<i32>, #blocked3>, tensor<16x1xi32, #blocked3>
    %16 = ttg.convert_layout %8 : tensor<16xi32, #blocked1> -> tensor<16xi32, #ttg.slice<{dim = 0, parent = #blocked4}>>
    %17 = tt.expand_dims %16 {axis = 0 : i32} : tensor<16xi32, #ttg.slice<{dim = 0, parent = #blocked4}>> -> tensor<1x16xi32, #blocked4>
    %18 = ttg.convert_layout %17 : tensor<1x16xi32, #blocked4> -> tensor<1x16xi32, #blocked>
    %19 = tt.broadcast %15 : tensor<16x1x!tt.ptr<i32>, #blocked3> -> tensor<16x16x!tt.ptr<i32>, #blocked3>
    %20 = ttg.convert_layout %19 : tensor<16x16x!tt.ptr<i32>, #blocked3> -> tensor<16x16x!tt.ptr<i32>, #blocked>
    %21 = tt.broadcast %18 : tensor<1x16xi32, #blocked> -> tensor<16x16xi32, #blocked>
    %22 = tt.addptr %20, %21 : tensor<16x16x!tt.ptr<i32>, #blocked>, tensor<16x16xi32, #blocked>
    %23 = tt.splat %arg2 : i32 -> tensor<16x1xi32, #blocked3>
    %24 = arith.cmpi slt, %11, %23 : tensor<16x1xi32, #blocked3>
    %25 = tt.splat %arg3 : i32 -> tensor<1x16xi32, #blocked>
    %26 = arith.cmpi slt, %18, %25 : tensor<1x16xi32, #blocked>
    %27 = tt.broadcast %24 : tensor<16x1xi1, #blocked3> -> tensor<16x16xi1, #blocked3>
    %28 = ttg.convert_layout %27 : tensor<16x16xi1, #blocked3> -> tensor<16x16xi1, #blocked>
    %29 = tt.broadcast %26 : tensor<1x16xi1, #blocked> -> tensor<16x16xi1, #blocked>
    %30 = arith.andi %28, %29 : tensor<16x16xi1, #blocked>
    %31 = tt.load %22, %30, %cst : tensor<16x16x!tt.ptr<i32>, #blocked>
    %32 = ttg.convert_layout %8 : tensor<16xi32, #blocked1> -> tensor<16xi32, #ttg.slice<{dim = 1, parent = #blocked2}>>
    %33 = tt.expand_dims %32 {axis = 1 : i32} : tensor<16xi32, #ttg.slice<{dim = 1, parent = #blocked2}>> -> tensor<16x1xi32, #blocked2>
    %34 = ttg.convert_layout %33 : tensor<16x1xi32, #blocked2> -> tensor<16x1xi32, #blocked3>
    %35 = arith.muli %34, %23 : tensor<16x1xi32, #blocked3>
    %36 = tt.splat %arg1 : !tt.ptr<i32> -> tensor<16x1x!tt.ptr<i32>, #blocked3>
    %37 = tt.addptr %36, %35 : tensor<16x1x!tt.ptr<i32>, #blocked3>, tensor<16x1xi32, #blocked3>
    %38 = ttg.convert_layout %4 : tensor<16xi32, #blocked1> -> tensor<16xi32, #ttg.slice<{dim = 0, parent = #blocked4}>>
    %39 = tt.expand_dims %38 {axis = 0 : i32} : tensor<16xi32, #ttg.slice<{dim = 0, parent = #blocked4}>> -> tensor<1x16xi32, #blocked4>
    %40 = ttg.convert_layout %39 : tensor<1x16xi32, #blocked4> -> tensor<1x16xi32, #blocked>
    %41 = tt.broadcast %37 : tensor<16x1x!tt.ptr<i32>, #blocked3> -> tensor<16x16x!tt.ptr<i32>, #blocked3>
    %42 = ttg.convert_layout %41 : tensor<16x16x!tt.ptr<i32>, #blocked3> -> tensor<16x16x!tt.ptr<i32>, #blocked>
    %43 = tt.broadcast %40 : tensor<1x16xi32, #blocked> -> tensor<16x16xi32, #blocked>
    %44 = tt.addptr %42, %43 : tensor<16x16x!tt.ptr<i32>, #blocked>, tensor<16x16xi32, #blocked>
    %45 = tt.trans %31 {order = array<i32: 1, 0>} : tensor<16x16xi32, #blocked> -> tensor<16x16xi32, #blocked5>
    %46 = ttg.convert_layout %45 : tensor<16x16xi32, #blocked5> -> tensor<16x16xi32, #blocked>
    %47 = arith.cmpi slt, %34, %12 : tensor<16x1xi32, #blocked3>
    %48 = tt.splat %arg2 : i32 -> tensor<1x16xi32, #blocked>
    %49 = arith.cmpi slt, %40, %48 : tensor<1x16xi32, #blocked>
    %50 = tt.broadcast %47 : tensor<16x1xi1, #blocked3> -> tensor<16x16xi1, #blocked3>
    %51 = ttg.convert_layout %50 : tensor<16x16xi1, #blocked3> -> tensor<16x16xi1, #blocked>
    %52 = tt.broadcast %49 : tensor<1x16xi1, #blocked> -> tensor<16x16xi1, #blocked>
    %53 = arith.andi %51, %52 : tensor<16x16xi1, #blocked>
    tt.store %44, %46, %53 : tensor<16x16x!tt.ptr<i32>, #blocked>
    tt.return
  }
}
