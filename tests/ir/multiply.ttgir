// RUN: ttvortex-opt %s --convert-triton-gpu-to-vortex-llvm --reconcile-unrealized-casts --canonicalize --cse | FileCheck %s

// Each of the 128 threads owns one element. Check the operand/result wiring,
// without pinning the SSA numbering or the address-calculation implementation.
// CHECK-LABEL: llvm.func @multiply
// CHECK: %[[X:.*]] = llvm.load %{{.*}} {alignment = 4 : i64} : !llvm.ptr -> i32
// CHECK: %[[Y:.*]] = llvm.load %{{.*}} {alignment = 4 : i64} : !llvm.ptr -> i32
// CHECK: %[[PRODUCT:.*]] = llvm.mul %[[X]], %[[Y]] : i32
// CHECK: llvm.store %[[PRODUCT]], %{{.*}} {alignment = 4 : i64} : i32, !llvm.ptr
// CHECK: llvm.return

#blocked = #ttg.blocked<{sizePerThread = [1], threadsPerWarp = [32], warpsPerCTA = [4], order = [0]}>
module attributes {"ttg.num-ctas" = 1 : i32, "ttg.num-warps" = 4 : i32, ttg.target = "vortex:32", "ttg.threads-per-warp" = 32 : i32} {
  tt.func public @multiply(%a: !tt.ptr<i32>, %b: !tt.ptr<i32>, %out: !tt.ptr<i32>) {
    %i = tt.make_range {start = 0 : i32, end = 128 : i32} : tensor<128xi32, #blocked>
    %aa = tt.splat %a : !tt.ptr<i32> -> tensor<128x!tt.ptr<i32>, #blocked>
    %bb = tt.splat %b : !tt.ptr<i32> -> tensor<128x!tt.ptr<i32>, #blocked>
    %oo = tt.splat %out : !tt.ptr<i32> -> tensor<128x!tt.ptr<i32>, #blocked>
    %ap = tt.addptr %aa, %i : tensor<128x!tt.ptr<i32>, #blocked>, tensor<128xi32, #blocked>
    %bp = tt.addptr %bb, %i : tensor<128x!tt.ptr<i32>, #blocked>, tensor<128xi32, #blocked>
    %op = tt.addptr %oo, %i : tensor<128x!tt.ptr<i32>, #blocked>, tensor<128xi32, #blocked>
    %x = tt.load %ap : tensor<128x!tt.ptr<i32>, #blocked>
    %y = tt.load %bp : tensor<128x!tt.ptr<i32>, #blocked>
    %product = arith.muli %x, %y : tensor<128xi32, #blocked>
    tt.store %op, %product : tensor<128x!tt.ptr<i32>, #blocked>
    tt.return
  }
}
