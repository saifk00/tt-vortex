// RUN: ttvortex-opt %s --convert-triton-gpu-to-vortex-llvm --reconcile-unrealized-casts --canonicalize --cse | FileCheck %s

// The load must be conditional, with zero passed along its inactive edge.
// The store must also be conditional and consume that load's merged value.
// CHECK-LABEL: llvm.func @masked_copy
// CHECK: %[[ZERO:.*]] = llvm.mlir.constant(0 : i32)
// CHECK: llvm.cond_br %[[MASK:.*]], ^[[READ:bb[0-9]+]], ^[[MERGE:bb[0-9]+]](%[[ZERO]] : i32)
// CHECK: ^[[READ]]:
// CHECK-NEXT: %[[LOADED:.*]] = llvm.load
// CHECK-NEXT: llvm.br ^[[MERGE]](%[[LOADED]] : i32)
// CHECK: ^[[MERGE]](%[[VALUE:[a-zA-Z0-9]+]]: i32):
// CHECK: llvm.cond_br %[[MASK]], ^[[WRITE:bb[0-9]+]], ^[[END:bb[0-9]+]]
// CHECK: ^[[WRITE]]:
// CHECK-NEXT: llvm.store %[[VALUE]],
// CHECK-NEXT: llvm.br ^[[END]]
// CHECK: ^[[END]]:
// CHECK-NEXT: llvm.return

#blocked = #ttg.blocked<{sizePerThread = [1], threadsPerWarp = [32], warpsPerCTA = [4], order = [0]}>
module attributes {"ttg.num-ctas" = 1 : i32, "ttg.num-warps" = 4 : i32, ttg.target = "vortex:32", "ttg.threads-per-warp" = 32 : i32} {
  tt.func public @masked_copy(%src: !tt.ptr<i32>, %dst: !tt.ptr<i32>, %n: i32) {
    %zero = arith.constant dense<0> : tensor<128xi32, #blocked>
    %i = tt.make_range {start = 0 : i32, end = 128 : i32} : tensor<128xi32, #blocked>
    %ns = tt.splat %n : i32 -> tensor<128xi32, #blocked>
    %mask = arith.cmpi slt, %i, %ns : tensor<128xi32, #blocked>
    %srcs = tt.splat %src : !tt.ptr<i32> -> tensor<128x!tt.ptr<i32>, #blocked>
    %dsts = tt.splat %dst : !tt.ptr<i32> -> tensor<128x!tt.ptr<i32>, #blocked>
    %sp = tt.addptr %srcs, %i : tensor<128x!tt.ptr<i32>, #blocked>, tensor<128xi32, #blocked>
    %dp = tt.addptr %dsts, %i : tensor<128x!tt.ptr<i32>, #blocked>, tensor<128xi32, #blocked>
    %value = tt.load %sp, %mask, %zero : tensor<128x!tt.ptr<i32>, #blocked>
    tt.store %dp, %value, %mask : tensor<128x!tt.ptr<i32>, #blocked>
    tt.return
  }
}
