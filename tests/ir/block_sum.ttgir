// RUN: ttvortex-opt %s --convert-triton-gpu-to-vortex-llvm --reconcile-unrealized-casts --canonicalize --cse | FileCheck %s --implicit-check-not='"tt.reduce"'

// Four warps exchange their partial sums through 16 bytes of shared memory.
// CHECK: ttg.shared = 16 : i32
// CHECK-LABEL: llvm.func @block_sum
// CHECK: %[[SHUFFLED:.*]] = llvm.inline_asm has_side_effects asm_dialect = att ".insn r 0x0b, 6, 1, $0, $1, $2"
// CHECK: llvm.add %{{.*}}, %[[SHUFFLED]] : i32
// CHECK: llvm.store {{.*}} : vector<1xi32>, !llvm.ptr
// CHECK: llvm.inline_asm has_side_effects asm_dialect = att ".insn r 0x0b, 4, 0, x0, $0, $1", "r,r,~{memory}"
// CHECK: llvm.load {{.*}} : !llvm.ptr -> vector<1xi32>
// CHECK: llvm.store {{.*}} : i32, !llvm.ptr
// CHECK: llvm.return

#blocked = #ttg.blocked<{sizePerThread = [1], threadsPerWarp = [32], warpsPerCTA = [4], order = [0]}>
module attributes {"ttg.num-ctas" = 1 : i32, "ttg.num-warps" = 4 : i32, ttg.target = "vortex:32", "ttg.threads-per-warp" = 32 : i32} {
  tt.func public @block_sum(%src: !tt.ptr<i32>, %out: !tt.ptr<i32>, %n: i32) {
    %zero = arith.constant dense<0> : tensor<256xi32, #blocked>
    %block = arith.constant 256 : i32
    %pid = tt.get_program_id x : i32
    %start = arith.muli %pid, %block : i32
    %range = tt.make_range {start = 0 : i32, end = 256 : i32} : tensor<256xi32, #blocked>
    %starts = tt.splat %start : i32 -> tensor<256xi32, #blocked>
    %offsets = arith.addi %starts, %range : tensor<256xi32, #blocked>
    %base = tt.splat %src : !tt.ptr<i32> -> tensor<256x!tt.ptr<i32>, #blocked>
    %ptrs = tt.addptr %base, %offsets : tensor<256x!tt.ptr<i32>, #blocked>, tensor<256xi32, #blocked>
    %ns = tt.splat %n : i32 -> tensor<256xi32, #blocked>
    %mask = arith.cmpi slt, %offsets, %ns : tensor<256xi32, #blocked>
    %values = tt.load %ptrs, %mask, %zero : tensor<256x!tt.ptr<i32>, #blocked>
    %sum = "tt.reduce"(%values) <{axis = 0 : i32}> ({
    ^bb0(%lhs: i32, %rhs: i32):
      %added = arith.addi %lhs, %rhs : i32
      tt.reduce.return %added : i32
    }) : (tensor<256xi32, #blocked>) -> i32
    %dst = tt.addptr %out, %pid : !tt.ptr<i32>, i32
    tt.store %dst, %sum : !tt.ptr<i32>
    tt.return
  }
}
