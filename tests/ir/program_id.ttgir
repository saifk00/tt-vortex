// RUN: ttvortex-opt %s --convert-triton-gpu-to-vortex-llvm --canonicalize --cse | FileCheck %s

module attributes {"ttg.num-ctas" = 1 : i32, "ttg.num-warps" = 4 : i32, ttg.target = "vortex:32", "ttg.threads-per-warp" = 32 : i32} {
  // CHECK-LABEL: llvm.func @program_x
  // CHECK: %[[CSR:.*]] = llvm.mlir.constant(3286 : i32)
  // CHECK: %[[ID:.*]] = llvm.inline_asm asm_dialect = att "csrr $0, $1", "=r,i" %[[CSR]] : (i32) -> i32
  // CHECK: llvm.return %[[ID]] : i32
  tt.func public @program_x() -> i32 {
    %id = tt.get_program_id x : i32
    tt.return %id : i32
  }

  // CHECK-LABEL: llvm.func @program_y
  // CHECK: %[[CSR:.*]] = llvm.mlir.constant(3287 : i32)
  // CHECK: %[[ID:.*]] = llvm.inline_asm asm_dialect = att "csrr $0, $1", "=r,i" %[[CSR]] : (i32) -> i32
  // CHECK: llvm.return %[[ID]] : i32
  tt.func public @program_y() -> i32 {
    %id = tt.get_program_id y : i32
    tt.return %id : i32
  }

  // CHECK-LABEL: llvm.func @program_z
  // CHECK: %[[CSR:.*]] = llvm.mlir.constant(3288 : i32)
  // CHECK: %[[ID:.*]] = llvm.inline_asm asm_dialect = att "csrr $0, $1", "=r,i" %[[CSR]] : (i32) -> i32
  // CHECK: llvm.return %[[ID]] : i32
  tt.func public @program_z() -> i32 {
    %id = tt.get_program_id z : i32
    tt.return %id : i32
  }

  // CHECK-LABEL: llvm.func @grid_x
  // CHECK: %[[CSR:.*]] = llvm.mlir.constant(3292 : i32)
  // CHECK: %[[ID:.*]] = llvm.inline_asm asm_dialect = att "csrr $0, $1", "=r,i" %[[CSR]] : (i32) -> i32
  // CHECK: llvm.return %[[ID]] : i32
  tt.func public @grid_x() -> i32 {
    %id = tt.get_num_programs x : i32
    tt.return %id : i32
  }
}
