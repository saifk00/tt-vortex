// RUN: ttvortex-opt %s --pass-pipeline='builtin.module(convert-scf-to-cf,convert-triton-gpu-to-vortex-llvm,reconcile-unrealized-casts,canonicalize,cse,symbol-dce)' -o %t
// RUN: FileCheck %s --input-file=%t --implicit-check-not='tensor<' --implicit-check-not='unrealized_conversion_cast' --implicit-check-not='tt.' --implicit-check-not='ttg.convert_layout'

// Generated from examples/basic.py via TTIR -> ttvortex-opt (see README.md).
// Positive test: lowering must succeed; no expected failure or diagnostic match.
// Inclusive scan across 256 values, not four independent warp scans.
// Contract follows Triton's generic scan lowering with Vortex TargetInfo:
// upward shuffles inside warps; shared partial sums + barrier between warps.
// Two chunks * four warps * sizeof(i32) require 32 bytes of scratch.
// CHECK: ttg.shared = 32 : i32
// CHECK-LABEL: llvm.func @prefix_sum
// CHECK: llvm.load {{.*}} : !llvm.ptr -> i32
// CHECK: %[[UP:.*]] = llvm.inline_asm has_side_effects asm_dialect = att ".insn r 0x0b, 4, 1, $0, $1, $2"
// CHECK: %[[SUM:.*]] = llvm.add %[[UP]], %{{.*}} : i32
// CHECK: llvm.select %{{.*}}, %[[SUM]], %{{.*}} : i1, i32
// CHECK: llvm.store {{.*}} : {{(vector<1xi32>|i32)}}, !llvm.ptr
// CHECK: llvm.inline_asm has_side_effects asm_dialect = att ".insn r 0x0b, 4, 0, x0, $0, $1", "r,r,~{memory}"
// CHECK: %[[PARTIAL:.*]] = llvm.load {{.*}} : !llvm.ptr -> i32
// CHECK: llvm.add %[[PARTIAL]], %{{.*}} : i32
// CHECK: llvm.cond_br
// CHECK: llvm.store {{.*}} : i32, !llvm.ptr
// CHECK: llvm.cond_br
// CHECK: llvm.store {{.*}} : i32, !llvm.ptr
// CHECK: llvm.return

#blocked = #ttg.blocked<{sizePerThread = [1], threadsPerWarp = [32], warpsPerCTA = [4], order = [0]}>
module attributes {"ttg.num-ctas" = 1 : i32, "ttg.num-warps" = 4 : i32, ttg.target = "vortex:32", "ttg.threads-per-warp" = 32 : i32} {
  tt.func public @prefix_sum(%arg0: !tt.ptr<i32>, %arg1: !tt.ptr<i32>, %arg2: i32) attributes {noinline = false} {
    %cst = arith.constant dense<0> : tensor<256xi32, #blocked>
    %c256_i32 = arith.constant 256 : i32
    %0 = tt.get_program_id x : i32
    %1 = arith.muli %0, %c256_i32 : i32
    %2 = tt.make_range {end = 256 : i32, start = 0 : i32} : tensor<256xi32, #blocked>
    %3 = tt.splat %1 : i32 -> tensor<256xi32, #blocked>
    %4 = arith.addi %3, %2 : tensor<256xi32, #blocked>
    %5 = tt.splat %arg0 : !tt.ptr<i32> -> tensor<256x!tt.ptr<i32>, #blocked>
    %6 = tt.addptr %5, %4 : tensor<256x!tt.ptr<i32>, #blocked>, tensor<256xi32, #blocked>
    %7 = tt.splat %arg2 : i32 -> tensor<256xi32, #blocked>
    %8 = arith.cmpi slt, %4, %7 : tensor<256xi32, #blocked>
    %9 = tt.load %6, %8, %cst : tensor<256x!tt.ptr<i32>, #blocked>
    %10 = "tt.scan"(%9) <{axis = 0 : i32, reverse = false}> ({
    ^bb0(%arg3: i32, %arg4: i32):
      %13 = arith.addi %arg3, %arg4 : i32
      tt.scan.return %13 : i32
    }) : (tensor<256xi32, #blocked>) -> tensor<256xi32, #blocked>
    %11 = tt.splat %arg1 : !tt.ptr<i32> -> tensor<256x!tt.ptr<i32>, #blocked>
    %12 = tt.addptr %11, %4 : tensor<256x!tt.ptr<i32>, #blocked>, tensor<256xi32, #blocked>
    tt.store %12, %10, %8 : tensor<256x!tt.ptr<i32>, #blocked>
    tt.return
  }
}
