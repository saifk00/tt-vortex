// RUN: ttvortex-opt %s --pass-pipeline='builtin.module(convert-scf-to-cf,convert-triton-gpu-to-vortex-llvm,reconcile-unrealized-casts,canonicalize,cse,symbol-dce)' -o %t
// RUN: FileCheck %s --input-file=%t --implicit-check-not='tensor<' --implicit-check-not='unrealized_conversion_cast' --implicit-check-not='tt.' --implicit-check-not='ttg.convert_layout'

// Generated from examples/basic.py via TTIR -> ttvortex-opt (see README.md).
// Positive test: lowering must succeed; no expected failure or diagnostic match.
// Two elements per thread, both accumulated into the SAME output pointer.
// Relaxed device-scope addition becomes monotonic atomicrmw (system scope is
// also valid). Each atomic must be guarded by its input's bounds predicate.
// CHECK-LABEL: llvm.func @atomic_sum(
// CHECK-SAME: %[[SRC:[a-zA-Z0-9_]+]]: !llvm.ptr, %[[OUT:[a-zA-Z0-9_]+]]: !llvm.ptr,
// CHECK: %[[ZERO:.*]] = llvm.mlir.constant(0 : i32)
// CHECK: llvm.cond_br %[[MASK0:.*]], ^[[READ_VALUE0:bb[0-9]+]], ^[[MERGE_VALUE0:bb[0-9]+]](%[[ZERO]] : i32)
// CHECK: ^[[READ_VALUE0]]:
// CHECK-NEXT: %[[LOAD_VALUE0:.*]] = llvm.load {{.*}} : !llvm.ptr -> i32
// CHECK-NEXT: llvm.br ^[[MERGE_VALUE0]](%[[LOAD_VALUE0]] : i32)
// CHECK: ^[[MERGE_VALUE0]](%[[VALUE0:[a-zA-Z0-9_]+]]: i32):
// CHECK: llvm.cond_br %[[MASK1:.*]], ^[[READ_VALUE1:bb[0-9]+]], ^[[MERGE_VALUE1:bb[0-9]+]](%[[ZERO]] : i32)
// CHECK: ^[[READ_VALUE1]]:
// CHECK-NEXT: %[[LOAD_VALUE1:.*]] = llvm.load {{.*}} : !llvm.ptr -> i32
// CHECK-NEXT: llvm.br ^[[MERGE_VALUE1]](%[[LOAD_VALUE1]] : i32)
// CHECK: ^[[MERGE_VALUE1]](%[[VALUE1:[a-zA-Z0-9_]+]]: i32):
// CHECK: llvm.cond_br %[[MASK0]], ^[[UPDATE0:bb[0-9]+]], ^[[END0:bb[0-9]+]]
// CHECK: ^[[UPDATE0]]:
// CHECK-NEXT: %{{.*}} = llvm.atomicrmw add %[[OUT]], %[[VALUE0]]{{( syncscope\("(device|system)"\))?}} monotonic {{.*}}: !llvm.ptr, i32
// CHECK-NEXT: llvm.br ^[[END0]]
// CHECK: llvm.cond_br %[[MASK1]], ^[[UPDATE1:bb[0-9]+]], ^[[END1:bb[0-9]+]]
// CHECK: ^[[UPDATE1]]:
// CHECK-NEXT: %{{.*}} = llvm.atomicrmw add %[[OUT]], %[[VALUE1]]{{( syncscope\("(device|system)"\))?}} monotonic {{.*}}: !llvm.ptr, i32
// CHECK-NEXT: llvm.br ^[[END1]]
// CHECK: llvm.return

#blocked = #ttg.blocked<{sizePerThread = [1], threadsPerWarp = [32], warpsPerCTA = [4], order = [0]}>
module attributes {"ttg.num-ctas" = 1 : i32, "ttg.num-warps" = 4 : i32, ttg.target = "vortex:32", "ttg.threads-per-warp" = 32 : i32} {
  tt.func public @atomic_sum(%arg0: !tt.ptr<i32>, %arg1: !tt.ptr<i32>, %arg2: i32) attributes {noinline = false} {
    %cst = arith.constant dense<0> : tensor<256xi32, #blocked>
    %c256_i32 = arith.constant 256 : i32
    %0 = tt.get_program_id x : i32
    %1 = arith.muli %0, %c256_i32 : i32
    %2 = tt.make_range {end = 256 : i32, start = 0 : i32} : tensor<256xi32, #blocked>
    %3 = tt.splat %1 : i32 -> tensor<256xi32, #blocked>
    %4 = arith.addi %3, %2 : tensor<256xi32, #blocked>
    %5 = tt.splat %arg0 : !tt.ptr<i32> -> tensor<256x!tt.ptr<i32>, #blocked>
    %6 = tt.addptr %5, %4 : tensor<256x!tt.ptr<i32>, #blocked>, tensor<256xi32, #blocked>
    %7 = tt.splat %arg2 : i32 -> tensor<256xi32, #blocked>
    %8 = arith.cmpi slt, %4, %7 : tensor<256xi32, #blocked>
    %9 = tt.load %6, %8, %cst : tensor<256x!tt.ptr<i32>, #blocked>
    %10 = tt.splat %arg1 : !tt.ptr<i32> -> tensor<256x!tt.ptr<i32>, #blocked>
    %11 = tt.atomic_rmw add, relaxed, gpu, %10, %9, %8 : (tensor<256x!tt.ptr<i32>, #blocked>, tensor<256xi32, #blocked>, tensor<256xi1, #blocked>) -> tensor<256xi32, #blocked>
    tt.return
  }
}
